# --- Environment & secrets ---
.env
.env.*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.coverage
htmlcov/

# --- Data & generated outputs ---
data/

# Source PDFs (large binary files) — personal / copyrighted material, never push
raw/*.pdf
inbox/

# Local logs (OCR runs, bot output, etc.)
logs/

# Embedding model cache (downloaded on first run, hundreds of MB)
.cache/

# OCR re-extraction intermediate files
data/reextracted/

# Exam app runtime state
exam/exam.sqlite
exam/exam.sqlite-*

# Vault decryption scratch dir (plaintext never committed)
.vault-plaintext/

# Age private key must never enter the repo
*.agekey

# ITILv5 webapp: runtime state (rebuilt from questions.json by init_db)
ITILv5/exam.sqlite
ITILv5/exam.sqlite-*

# ITILv5 official textbooks / sample papers — copyrighted, large binaries, never push
ITILv5/*.pdf
ITILv5/*.docx
ITILv5/ITIL_FND_*/

# --- IDE ---
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Build / packaging ---
dist/
build/
*.egg
